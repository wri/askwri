{
  "name": "askwri-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "search-service": "cd search-service && python3 -m venv venv && ./venv/bin/pip install -r requirements.txt && ./venv/bin/python -m app.main",
    "search-service:stop": "bash -c 'if lsof -Pi :8000 -sTCP:LISTEN -t >/dev/null 2>&1; then kill $(lsof -t -i:8000) 2>/dev/null; echo \"✅ Search service stopped\"; else echo \"ℹ️  Search service not running\"; fi'",
    "typeorm": "ts-node --project tsconfig.typeorm.json -r dotenv/config ./node_modules/typeorm/cli.js",
    "migration:generate": "DOTENV_CONFIG_PATH=.env npm run typeorm -- migration:generate src/db/migrations/Migration -d src/db/migration-data-source.ts",
    "migration:run": "DOTENV_CONFIG_PATH=.env npm run typeorm -- migration:run -d src/db/migration-data-source.ts",
    "migration:revert": "DOTENV_CONFIG_PATH=.env npm run typeorm -- migration:revert -d src/db/migration-data-source.ts",
    "eval:baseline-suite": "bash evaluation/run-baseline-suite.sh --daemon",
    "eval:cite": "npx tsx --env-file-if-exists=.env evaluation/run-cite-eval.ts",
    "eval:report": "npx tsx --env-file-if-exists=.env evaluation/generate-report.ts",
    "eval:answer-retrieval": "npx tsx --env-file-if-exists=.env evaluation/run-answer-retrieval-eval.ts",
    "eval:answer-report": "npx tsx --env-file-if-exists=.env evaluation/generate-answer-report.ts",
    "eval:golden-retrieve": "npx tsx --env-file-if-exists=.env evaluation/generate-answer-golden-set.ts --phase retrieve",
    "eval:golden-label": "npx tsx --env-file-if-exists=.env evaluation/generate-answer-golden-set.ts --phase label",
    "eval:golden-assemble": "npx tsx --env-file-if-exists=.env evaluation/generate-answer-golden-set.ts --phase assemble",
    "eval:golden-review": "npx tsx --env-file-if-exists=.env evaluation/serve-label-review.ts",
    "eval:synthesis-capture": "npx tsx --env-file-if-exists=.env evaluation/run-answer-synthesis-capture.ts",
    "eval:synthesis-llm-eval": "npx tsx --env-file-if-exists=.env evaluation/run-answer-synthesis-llm-eval.ts",
    "eval:synthesis-prepare-review": "npx tsx --env-file-if-exists=.env evaluation/prepare-synthesis-review.ts",
    "eval:synthesis-assemble": "npx tsx --env-file-if-exists=.env evaluation/assemble-synthesis-ground-truth.ts",
    "eval:upload": "npx tsx --env-file-if-exists=.env evaluation/upload-eval-to-s3.ts",
    "eval:download": "npx tsx --env-file-if-exists=.env evaluation/download-eval-from-s3.ts",
    "test:python": "cd search-service && ./venv/bin/python -m pytest tests/ -v",
    "test:db": "DATABASE_URL=postgresql://askwri:password@localhost:5432/qa DATABASE_SSL=false jest --testPathPattern='db.test'",
    "seed:admin": "ts-node --project tsconfig.typeorm.json -r dotenv/config scripts/seed-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.997.0",
    "@chakra-ui/react": "^3.31.0",
    "@emotion/react": "^11.14.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@worldresources/wri-design-systems": "^2.188.0",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^6.1.0",
    "docx": "^9.5.1",
    "jose": "^6.2.3",
    "lightningcss": "^1.31.1",
    "next": "^16.2.4",
    "openai": "^6.22.0",
    "pg": "^8.18.0",
    "postcss": "^8.5.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^16.2.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@ungap/structured-clone": "^1.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "picomatch": "^4.0.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "undici": "^8.4.1"
  }
}
