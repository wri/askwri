{
  "name": "askwri-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "search-service": "cd search-service && python3 -m venv venv && ./venv/bin/pip install -r requirements.txt && ./venv/bin/python -m app.main",
    "search-service:stop": "bash -c 'if lsof -Pi :8000 -sTCP:LISTEN -t >/dev/null 2>&1; then kill $(lsof -t -i:8000) 2>/dev/null; echo \"✅ Search service stopped\"; else echo \"ℹ️  Search service not running\"; fi'",
    "eval:cite": "npx tsx evaluation/run-cite-eval.ts",
    "eval:report": "npx tsx evaluation/generate-report.ts",
    "eval:answer-retrieval": "npx tsx evaluation/run-answer-retrieval-eval.ts",
    "eval:answer-synthesis": "npx tsx evaluation/run-answer-synthesis-wrapper.ts",
    "eval:answer-report": "npx tsx evaluation/generate-answer-report.ts",
    "eval:answer-full": "npm run eval:answer-retrieval && npm run eval:answer-synthesis"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.31.0",
    "@emotion/react": "^11.14.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@worldresources/wri-design-systems": "^2.183.1",
    "csv-parse": "^6.1.0",
    "docx": "^9.5.1",
    "lightningcss": "^1.31.1",
    "next": "^16.1.6",
    "openai": "^6.22.0",
    "postcss": "^8.5.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-icons": "^5.5.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/eslint-plugin-next": "^16.1.6",
    "@testing-library/jest-dom": "6.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-next": "^14.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "picomatch": "^4.0.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
