# Required because eslint-config-next@16 peers eslint>=9, but the
# eslint-config-airbnb* ecosystem has not released eslint v9 support.
# Until airbnb publishes a v9-compatible release (or we migrate off airbnb
# to eslint flat config), we stay on eslint v8 and tolerate the peer
# mismatch via legacy-peer-deps.
legacy-peer-deps=true
