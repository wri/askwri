# Application Environment
NEXT_PUBLIC_ENVIRONMENT=development
NEXTJS_SERVER_URL=http://localhost:3000

# Search Service Configuration
# URL for the Python search/retrieval service
SEARCH_SERVICE_URL=http://localhost:8000

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=800
OPENAI_TEMPERATURE=0.3

# Optional Model Overrides
# OPENAI_MODEL_ALIGNMENT=gpt-4o-mini
# OPENAI_MODEL_WHY=gpt-4-turbo
# OPENAI_MODEL_RELATES=gpt-4-turbo

# Anthropic Configuration (for evaluation/golden set generation)
ANTHROPIC_API_KEY=sk-ant-...

# Energy Impact Configuration
# Power Usage Effectiveness
ENERGY_PUE=1.1
# Grid Carbon Intensity (gCO2/kWh)
ENERGY_GRID_GCO2_PER_KWH=475

# File Metadata
# Path to file metadata JSON (optional)
# FILE_METADATA_PATH=./data/metadata.json

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=askwri
DB_PASSWORD=password
DB_NAME=qa
DATABASE_SSL_REJECT_UNAUTHORIZED=false
