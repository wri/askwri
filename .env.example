# Application Environment
NEXT_PUBLIC_ENVIRONMENT=development
NEXTJS_SERVER_URL=http://localhost:3000

# Search Service Configuration
# URL for the Python search/retrieval service
SEARCH_SERVICE_URL=http://localhost:8000
# Same service, used by evaluation scripts
LLAMAINDEX_SERVICE_URL=http://localhost:8000

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=800
OPENAI_TEMPERATURE=0.3

# Optional Model Overrides
# OPENAI_MODEL_ALIGNMENT=gpt-4o-mini
# OPENAI_MODEL_WHY=gpt-4-turbo
# OPENAI_MODEL_RELATES=gpt-4-turbo

# On-demand English translation of a citation excerpt (/api/translate).
# Optional: defaults to OPENAI_MODEL, then gpt-5-mini if neither is set.
# OPENAI_MODEL_TRANSLATE=gpt-5-mini

# Answer mode corpus coverage pre-check (absolute signal)
# Optional: defaults to OPENAI_MODEL_WHY, then gpt-5.4-nano if neither is set
# OPENAI_MODEL_COVERAGE=gpt-5.4-nano

# Nano model for answer mode relevance filter (default: gpt-5.4-nano)
OPENAI_MODEL_NANO=gpt-5.4-nano

# Anthropic Configuration (for evaluation/golden set generation)
ANTHROPIC_API_KEY=sk-ant-...

# Energy Impact Configuration
# Power Usage Effectiveness
ENERGY_PUE=1.1
# Grid Carbon Intensity (gCO2/kWh)
ENERGY_GRID_GCO2_PER_KWH=475

# File Metadata
# Path to file metadata JSON (optional)
# FILE_METADATA_PATH=./data/metadata.json

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=askwri
DB_PASSWORD=password
DB_NAME=qa
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Set to false for local dev databases without SSL (e.g. docker)
# DATABASE_SSL=false
# Single-URL form (used by the Python search-service and migration script;
# append ?sslmode=require for RDS)
DATABASE_URL=postgresql://askwri:password@localhost:5432/qa

# Phase 0 cutover flags
# Search service retrieval source: legacy (CSV + boot-time build) | postgres
RETRIEVAL_BACKEND=legacy
# /api/catalog source: unset/csv (legacy) | postgres
# CATALOG_SOURCE=postgres
# Keyword lane: "sparse" (Postgres-resident, default) | "memory" (legacy in-memory BM25)
KEYWORD_BACKEND=sparse
# English handles into sparse weights (spec 2026-07-26). Must match across:
# backfill shell, ingestion worker env. See docs/runbooks/qa-push-deploy.md.
SPARSE_EN_HANDLES=false
# Cite mode: show a real passage instead of the synthetic summary node for
# documents the summary node won, carrying its score and tier over so ranking
# is unchanged (issue #233). Search service only; no backfill needed.
CITE_SUBSTITUTE_SUMMARY_PASSAGE=false

# Ingestion worker (Phase 1)
WORKER_LLM_MODEL=gpt-5-mini        # model used for doc summaries and tag generation
INTAKE_S3_PREFIX=intake/            # S3 prefix the worker watches for new PDFs
# INTAKE_LOCAL_DIR=./intake          # local-dev alternative to S3 intake
# Topic classification and reclassification worker controls
TAG_CANDIDATE_TOP_N=20              # nearest embedded topic candidates sent to the classifier
TAG_RECLASSIFY_CONCURRENCY=4        # independently claimed reclassification jobs per poll
TAG_EMBED_BATCH_SIZE=100            # topic embeddings built per batch
CLASSIFY_TOPIC_ONLY=false           # restrict ordinary classify runs to the topic facet
RECLASSIFY_POLL_FIRST=true          # service reclassification before ingestion jobs

# --- Multilingual v3 retrieval (all-Bedrock; spec 2026-07-07 as amended) ---
# Dense model: cohere-embed-v4 (Bedrock, default) | text-embedding-3-small
# (OpenAI rollback while 3-small rows/index still exist)
# EMBEDDING_MODEL=cohere-embed-v4
# Bedrock placement (infra is us-east-2; both models are cross-region calls)
# BEDROCK_EMBED_REGION=us-east-1
# BEDROCK_EMBED_MODEL_ID=cohere.embed-v4:0   # us.cohere.embed-v4:0 for bulk re-embeds (2x quota)
# BEDROCK_RERANK_REGION=us-west-2
# BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
# Bulk Bedrock jobs (re-embed / re-ingest): required or jobs die on ThrottlingException
# AWS_RETRY_MODE=adaptive
# AWS_MAX_ATTEMPTS=10

# --- Parse backend (bake-off 2026-07-22; pypdf default until Phase 1 gate) ---
# PARSE_BACKEND=pypdf                # pypdf | mistral
# MISTRAL_API_KEY=                   # required when PARSE_BACKEND=mistral
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# Parse cache: re-ingest reuses stored text when the PDF bytes and the
# backend/model are unchanged (skips the OCR call). Set true to force re-OCR.
# FORCE_REPARSE=false

# --- Phase 2 admin UI ---
# Session signing secret for /admin login (>= 32 chars). Generate: openssl rand -hex 32
SESSION_SECRET=
# Optional: bearer token that lets scripts call /api/import-documents and /api/admin/*
# without a browser session (acts as admin, audited as source='system').
ADMIN_API_TOKEN=
# Local dir for admin PDF preview when DOCUMENTS_S3_BUCKET is unset (dev)
# ADMIN_PDF_LOCAL_DIR=/tmp/askWRI_docs

# Local development without AWS: run ./scripts/local-bootstrap.sh, which writes
# gitignored .env.local / .env.test.local / search-service/.env.local overrides.
# Precedence: real env > .env.local > .env. See docs/runbooks/local-testing.md.
