# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# LlamaParse Configuration (for document processing)
LLAMA_CLOUD_API_KEY=your-llama-cloud-api-key-here

# Service Configuration
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8001

# Evaluation Configuration
EVAL_MODE=development  # development, production
EVAL_LOG_LEVEL=INFO

# Model Configuration
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_ANSWER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
RERANKER_CITE_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval Configuration
DEFAULT_CHUNK_SIZE=400
DEFAULT_CHUNK_OVERLAP=80
DEFAULT_SIMILARITY_THRESHOLD=0.0

# Mode-specific configurations
ANSWER_MODE_DENSE_WEIGHT=0.5
ANSWER_MODE_SPARSE_WEIGHT=0.5
ANSWER_MODE_FUSION_TOP_K=50
ANSWER_MODE_RERANK_TOP_N=20

CITE_MODE_DENSE_WEIGHT=0.3
CITE_MODE_SPARSE_WEIGHT=0.7
CITE_MODE_FUSION_TOP_K=100
CITE_MODE_RERANK_TOP_N=50

# Data paths
CSV_METADATA_PATH=../public/TransportDecarb_llamacloud_metadata_with_summaries.csv
DOCUMENTS_PATH=../documents  # Where PDFs will be stored for processing
INDEX_STORAGE_PATH=./storage  # Where indexes will be persisted

# Evaluation dataset paths
EVAL_QUERIES_PATH=./evaluation/queries.json
EVAL_GROUND_TRUTH_PATH=./evaluation/ground_truth.json