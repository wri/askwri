# =============================================================================
# Search Service Environment Variables
# =============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
PORT=8000
WORKERS=1
LOG_LEVEL=debug

# Next.js Backend URL (for internal communication)
NEXTJS_BACKEND_URL=http://localhost:3000

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Document storage (local dev: use ./data to persist across restarts)
# DOCUMENTS_LOCAL_DIR=./data
# CACHE_DIR=./data/cache

# SSL/Zscaler VPN Workaround
# Set to "true" to use custom HTTP client with SSL certificates for corporate VPN/proxy environments
# This is needed when Zscaler or similar tools insert custom SSL certificates
USE_CUSTOM_SSL_CLIENT=false
# Optional: Path to custom CA bundle (if not set, system defaults are used)
# CUSTOM_CA_BUNDLE=/path/to/your/ca-bundle.crt

# English handles into sparse weights (spec 2026-07-26). Must match across:
# backfill shell, ingestion worker env. See docs/runbooks/qa-push-deploy.md.
SPARSE_EN_HANDLES=false
